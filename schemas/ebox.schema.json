{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rino.example/schemas/ebox.schema.json",
  "title": "RINO evidence object",
  "type": "object",
  "required": ["id", "slug", "title", "category", "subjects", "tags", "relevantDate", "claimStatus", "factualSummary", "whyItMatters", "claims", "sources", "sourceRelationships", "limitingContext", "denialsAndResponses", "corrections", "applicableTests", "expertInterviewCompanion", "editorialReview"],
  "properties": {
    "id": { "type": "string", "pattern": "^RINO-EBOX-[0-9]{4}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 10 },
    "category": { "type": "string" },
    "subjects": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "relevantDate": { "type": "string" },
    "claimStatus": { "type": "string" },
    "factualSummary": { "type": "string" },
    "whyItMatters": { "type": "string" },
    "claims": { "type": "array", "minItems": 1 },
    "sources": { "type": "array", "minItems": 1 },
    "sourceRelationships": { "type": "array", "minItems": 1 },
    "limitingContext": { "type": "array" },
    "denialsAndResponses": { "type": "array" },
    "corrections": { "type": "array" },
    "applicableTests": { "type": "array" },
    "expertInterviewCompanion": { "type": "object" },
    "editorialReview": { "type": "object" }
  },
  "additionalProperties": false
}
